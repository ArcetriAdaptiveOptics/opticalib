include README.md
include LICENSE
include CITATION.bib
include opticalib/core/_configurations/configuration.yaml
include opticalib/simulator/_API/alpao_conf.yaml
include opticalib/__init_script__/initCalpy.py
recursive-include opticalib/gui/resources *.svg *.png *.ico
graft tests
# setuptools-scm adds every git-tracked file to the sdist: drop the dev-only ones.
prune docs
prune .github
exclude CLAUDE.md
exclude labott.code-workspace
exclude .readthedocs.yaml
exclude .gitignore
global-exclude __pycache__ *.py[cod]
